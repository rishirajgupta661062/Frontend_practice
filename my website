<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MKG PaintCare | Home Painting Services</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body {
  background: #f5f7fa;
  color: #172b45;
}

header {
  background: #142b45;
  color: white;
  padding: 20px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
}

.logo {
  font-size: 25px;
  font-weight: bold;
  color: #f2b544;
}

nav a {
  color: white;
  text-decoration: none;
  margin-left: 20px;
}

.hero {
  background: linear-gradient(120deg, #142b45, #2463a6);
  color: white;
  padding: 90px 7%;
  text-align: center;
}

.hero h1 {
  font-size: 42px;
  margin-bottom: 20px;
}

.hero p {
  font-size: 18px;
  margin-bottom: 25px;
}

.btn {
  display: inline-block;
  background: #f2b544;
  color: #142b45;
  padding: 13px 25px;
  border-radius: 7px;
  text-decoration: none;
  font-weight: bold;
  border: none;
  cursor: pointer;
}

section {
  padding: 60px 7%;
}

.heading {
  text-align: center;
  font-size: 30px;
  margin-bottom: 30px;
}

.services {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.card {
  background: white;
  padding: 25px;
  border-radius: 12px;
  box-shadow: 0 3px 12px #0001;
  text-align: center;
}

.card h3 {
  margin-bottom: 12px;
  color: #2463a6;
}

.card p {
  color: #64748b;
}

.about {
  background: white;
  text-align: center;
}

.about p {
  max-width: 750px;
  margin: auto;
  line-height: 1.8;
}

.form-section {
  background: #eaf0f7;
}

form {
  max-width: 700px;
  margin: auto;
  background: white;
  padding: 30px;
  border-radius: 12px;
}

form input,
form select,
form textarea {
  width: 100%;
  padding: 13px;
  margin: 8px 0 17px;
  border: 1px solid #ccc;
  border-radius: 6px;
}

form label {
  font-weight: bold;
}

form textarea {
  height: 100px;
}

form button {
  width: 100%;
  font-size: 16px;
}

footer {
  background: #142b45;
  color: white;
  text-align: center;
  padding: 30px;
  line-height: 1.8;
}

@media(max-width: 600px) {
  header {
    gap: 15px;
  }

  nav a {
    margin: 0 8px;
    font-size: 13px;
  }

  .hero h1 {
    font-size: 30px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">MKG PAINTCARE</div>
  <nav>
    <a href="#home">Home</a>
    <a href="#services">Services</a>
    <a href="#about">About</a>
    <a href="#booking">Contact</a>
  </nav>
</header>

<section class="hero" id="home">
  <h1>Your Home, Our Responsibility!</h1>
  <p>
    Professional Home Painting Services in India.
    Living Abroad? Get Your Indian Home Repainted Without Travelling.
  </p>
  <a href="#booking" class="btn">Book a Site Visit</a>
</section>

<section id="services">
  <h2 class="heading">Our Painting Services</h2>

  <div class="services">
    <div class="card">
      <h3>Interior Painting</h3>
      <p>Beautiful painting for bedrooms, halls and kitchens.</p>
    </div>

    <div class="card">
      <h3>Exterior Painting</h3>
      <p>Professional painting for outside walls and buildings.</p>
    </div>

    <div class="card">
      <h3>Full House Painting</h3>
      <p>Complete home repainting with proper inspection.</p>
    </div>
  </div>
</section>

<section class="about" id="about">
  <h2 class="heading">About MKG PaintCare</h2>

  <p>
    MKG PaintCare is a home painting service led by
    Munna Kumar Gupta. We help homeowners living in
    India and abroad manage their home painting projects.
    Customers can submit their property details and
    caretaker information. We arrange a site inspection
    and discuss the quotation before starting work.
  </p>
</section>

<section class="form-section" id="booking">
  <h2 class="heading">Register Your Painting Requirement</h2>

  <form id="bookingForm">

    <label>Your Name</label>
    <input type="text" id="name" required>

    <label>Country Where You Live</label>
    <input type="text" id="country" required>

    <label>Your WhatsApp Number</label>
    <input type="tel" id="phone" required>

    <label>Email Address</label>
    <input type="email" id="email">

    <label>House Number</label>
    <input type="text" id="house" required>

    <label>Complete Address in India</label>
    <textarea id="address" required></textarea>

    <label>Caretaker Name</label>
    <input type="text" id="caretaker" required>

    <label>Caretaker Mobile Number</label>
    <input type="tel" id="caretakerPhone" required>

    <label>Painting Requirement</label>
    <select id="service" required>
      <option value="">Select Service</option>
      <option>Interior Painting</option>
      <option>Exterior Painting</option>
      <option>Full House Painting</option>
      <option>Other</option>
    </select>

    <label>Upload House Photos</label>
    <input type="file" id="photos" accept="image/*" multiple>

    <label>Additional Details</label>
    <textarea id="details"></textarea>

    <label>
      <input type="checkbox" id="consent" required style="width:auto">
      I am authorised to share these property and caretaker details.
    </label>

    <button type="submit" class="btn">
      Submit Registration
    </button>

  </form>
</section>

<footer>
  <h2>MKG PAINTCARE</h2>
  <p>Owner: Munna Kumar Gupta</p>
  <p>Professional Home Painting Services</p>
  <p>India</p>
  <p>© 2026 MKG PaintCare. All Rights Reserved.</p>
</footer>

<script>
document.getElementById("bookingForm")
.addEventListener("submit", function(e) {

  e.preventDefault();

  // Replace with father's WhatsApp number.
  // Example: 919876543210
  const businessNumber = "91XXXXXXXXXX";

  if (businessNumber.includes("X")) {
    alert("Please add your business WhatsApp number in the code.");
    return;
  }

  const fields = [
    ["Customer", "name"],
    ["Country", "country"],
    ["Customer Phone", "phone"],
    ["Email", "email"],
    ["House Number", "house"],
    ["Address", "address"],
    ["Caretaker", "caretaker"],
    ["Caretaker Phone", "caretakerPhone"],
    ["Service", "service"],
    ["Additional Details", "details"]
  ];

  let message = "NEW PAINTING ENQUIRY\n\n";

  fields.forEach(([label, id]) => {
    message += label + ": " +
      document.getElementById(id).value + "\n";
  });

  message += "\nCustomer will attach house photos separately.";

  const url = "https://wa.me/" + businessNumber +
    "?text=" + encodeURIComponent(message);

  window.open(url, "_blank");

  alert("WhatsApp opened. Please attach the house photos in the chat.");
});
</script>

</body>
</html>